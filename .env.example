VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Leave the two below UNSET (or VITE_BACKEND_MODE=supabase) for the normal,
# deployed-for-other-people setup — that's what talks to Supabase above.
# Set VITE_BACKEND_MODE=api only if you've set up server/ (see server/README.md)
# to run on your own Postgres/MySQL/MariaDB/MongoDB instead.
# VITE_BACKEND_MODE=api
# VITE_API_URL=http://localhost:4000
