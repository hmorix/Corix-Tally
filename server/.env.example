# Set EXACTLY ONE of these three — whichever is present decides which
# database the server uses. Priority if more than one is set: Mongo > MySQL/MariaDB > Postgres.

# Option A — Postgres (local Postgres OR Supabase's own Postgres connection
# string, found in Supabase: Project Settings > Database > Connection string > URI)
# DATABASE_URL="postgresql://user:password@localhost:5432/corix_tally"

# Option B — MySQL or MariaDB (same driver, MariaDB is wire-compatible with MySQL)
# MYSQL_URL="mysql://user:password@localhost:3306/corix_tally"

# Option C — MongoDB (local or Atlas free tier)
# MONGODB_URI="mongodb://localhost:27017/corix_tally"

JWT_SECRET=change-this-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
PORT=4000
