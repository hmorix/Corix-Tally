// Default Prisma schema for Corix Tally (PostgreSQL / Supabase)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String?
  fullName            String?
  googleId            String?  @unique
  entryLimit          Int      @default(50000)
  googleSheetId       String?
  googleAccessToken   String?
  createdAt           DateTime @default(now())
}

model Company {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  gstin              String?
  state              String?
  financialYearStart DateTime @default(now())
  createdAt          DateTime @default(now())
}

model LedgerGroup {
  id        String  @id @default(uuid())
  companyId String
  name      String
  nature    String
  isSystem  Boolean @default(false)
}

model Ledger {
  id                 String   @id @default(uuid())
  companyId          String
  groupId            String?
  name               String
  openingBalance     Float    @default(0)
  openingBalanceType String   @default("debit")
  gstin              String?
  gstRate            Float?
  createdAt          DateTime @default(now())
}

model Voucher {
  id            String   @id @default(uuid())
  companyId     String
  voucherType   String
  voucherNumber String?
  voucherDate   DateTime @default(now())
  narration     String?
  partyName     String?
  partyGstin    String?
  placeOfSupply String?
  invoiceNumber String?
  invoiceType   String?  @default("regular")
  createdAt     DateTime @default(now())
}

model VoucherEntry {
  id        String @id @default(uuid())
  voucherId String
  ledgerId  String
  debit     Float  @default(0)
  credit    Float  @default(0)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  companyId  String?
  entityType String
  entityId   String
  action     String
  detail     String?
  createdAt  DateTime @default(now())
}
